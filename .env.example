# --- General ---
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=prospectai
POSTGRES_PASSWORD=prospectai
POSTGRES_DB=prospectai
DATABASE_URL=postgresql+asyncpg://prospectai:prospectai@postgres:5432/prospectai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Seguridad / JWT ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AIProvider (adapter: OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- MessagingProvider (adapter: OpenWA) ---
OPENWA_BASE_URL=http://openwa:8080
OPENWA_API_KEY=

# --- ScraperProvider (adapter: gosom/google-maps-scraper) ---
SCRAPER_RESULTS_PATH=./integrations/google-maps-scraper/results

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
