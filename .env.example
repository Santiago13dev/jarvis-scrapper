# --- General ---
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=prospectai
POSTGRES_PASSWORD=prospectai
POSTGRES_DB=prospectai
DATABASE_URL=postgresql+asyncpg://prospectai:prospectai@postgres:5432/prospectai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Seguridad / JWT ---
# En producción la app NO arranca con este valor: genera uno con
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# false = solo se puede crear la primera organización (instalación privada de la agencia)
ALLOW_PUBLIC_REGISTRATION=true

# --- AIProvider (adapter: OpenAI) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- WhatsApp ---
# assisted  = Jarvis prepara la lista diaria y el mensaje; tú lo envías con un toque (recomendado)
# cloud_api = envío automático con la API oficial de Meta (WhatsApp Business Platform)
# openwa    = WhatsApp Web no oficial (riesgo de bloqueo del número; solo pruebas)
WHATSAPP_PROVIDER=assisted

# API oficial (Meta → WhatsApp → Configuración de la API)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v21.0
# Plantilla aprobada para el primer contacto ({{1}} = nombre del negocio)
WHATSAPP_CLOUD_TEMPLATE=
WHATSAPP_CLOUD_TEMPLATE_LANG=es
# Webhook: https://TU_DOMINIO/api/v1/whatsapp/cloud/webhook
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_WORKSPACE_ID=

# OpenWA (solo si WHATSAPP_PROVIDER=openwa)
OPENWA_BASE_URL=http://openwa:8080
OPENWA_API_KEY=
# Secreto que OpenWA debe enviar en la cabecera X-Webhook-Secret (obligatorio en producción)
OPENWA_WEBHOOK_SECRET=

# --- ScraperProvider (adapter: gosom/google-maps-scraper) ---
SCRAPER_RESULTS_PATH=./integrations/google-maps-scraper/results
SCRAPER_LATITUDE=4.6534
SCRAPER_LONGITUDE=-74.0836

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
